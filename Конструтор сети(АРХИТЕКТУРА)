**Indoor Path Loss Model:**
```python
import numpy as np
from scipy.interpolate import Rbf

class HeatmapCalculator:
    def __init__(self, floorplan, walls, access_points):
        self.floorplan = floorplan
        self.walls = walls
        self.access_points = access_points
    
    def calculate_theoretical(self, resolution=0.5):
        """
        Расчёт теоретической heatmap
        Используем модель: PL = PL_0 + 10*n*log10(d) + sum(wall_attenuation)
        """
        grid = self._create_grid(resolution)
        signal_map = np.zeros(grid.shape)
        
        for ap in self.access_points:
            for i in range(grid.shape[0]):
                for j in range(grid.shape[1]):
                    point = grid[i, j]
                    distance = np.linalg.norm(point - ap.position)
                    
                    # Базовое затухание (FSPL at 1m + path loss exponent)
                    pl_0 = 40.05  # at 2.4GHz, 1m
                    n = 2.5  # path loss exponent for indoor
                    path_loss = pl_0 + 10 * n * np.log10(distance + 0.1)
                    
                    # Дополнительное затухание от стен
                    wall_loss = self._calculate_wall_loss(ap.position, point)
                    
                    # RSSI
                    rssi = ap.power_dbm + ap.antenna_gain - path_loss - wall_loss
                    signal_map[i, j] = max(signal_map[i, j], rssi)
        
        return grid, signal_map
    
    def calculate_measured(self, measurement_points):
        """
        Интерполяция по реальным замерам (IDW - Inverse Distance Weighting)
        """
        if len(measurement_points) < 3:
            return self.calculate_theoretical()
        
        grid = self._create_grid(0.5)
        
        # RBF интерполяция
        x = [mp.position[0] for mp in measurement_points]
        y = [mp.position[1] for mp in measurement_points]
        z = [mp.rssi_dbm for mp in measurement_points]
        
        rbf = Rbf(x, y, z, function='multiquadric')
        
        X, Y = np.meshgrid(
            np.arange(grid.bounds[0], grid.bounds[2], 0.5),
            np.arange(grid.bounds[1], grid.bounds[3], 0.5)
        )
        
        Z = rbf(X, Y)
        
        return (X, Y), Z
    
    def _calculate_wall_loss(self, p1, p2):
        """Расчёт потерь от пересечения стен"""
        total_loss = 0
        line = LineString([p1, p2])
        
        for wall in self.walls:
            if line.intersects(wall.geometry):
                # Затухание зависит от материала
                material_loss = {
                    'drywall': 3,
                    'concrete': 10,
                    'brick': 8,
                    'glass': 2,
                    'metal': 20
                }
                total_loss += material_loss.get(wall.material_type, 5)
        
        return total_loss
```

**Эвристики для рекомендаций AP:**
```python
def recommend_ap_placement(floorplan, walls, desired_coverage=-65):
    """
    Рекомендации по размещению точек доступа
    
    Эвристики:
    1. Равномерное покрытие (grid-based placement)
    2. Учёт центра масс помещения
    3. Избегание размещения у стен с высоким затуханием
    4. Минимальное перекрытие зон покрытия (~15-20%)
    5. Учёт типичного радиуса покрытия (15-20м для 2.4GHz)
    """
    recommendations = []
    
    # Размер ячейки покрытия (радиус ~15м)
    cell_size = 25  # meters
    
    # Разбиваем помещение на ячейки
    bounds = floorplan.bounds
    width = bounds[2] - bounds[0]
    height = bounds[3] - bounds[1]
    
    cols = int(width / cell_size) + 1
    rows = int(height / cell_size) + 1
    
    for row in range(rows):
        for col in range(cols):
            x = bounds[0] + col * cell_size + cell_size / 2
            y = bounds[1] + row * cell_size + cell_size / 2
            
            point = Point(x, y)
            
            # Проверяем, что точка внутри помещения
            if floorplan.contains(point):
                # Проверяем близость к стенам с высоким затуханием
                wall_penalty = calculate_wall_proximity_penalty(point, walls)
                
                # Корректируем позицию от стен
                adjusted_point = adjust_position_from_walls(point, walls, min_distance=2)
                
                recommendations.append({
                    'position': (adjusted_point.x, adjusted_point.y),
                    'confidence': 1.0 - wall_penalty,
                    'estimated_coverage_radius': 15 * (1 - wall_penalty * 0.3)
                })
    
    # Фильтруем перекрывающиеся рекомендации
    recommendations = filter_overlapping(recommendations, overlap_threshold=0.8)
    
    return recommendations
```

