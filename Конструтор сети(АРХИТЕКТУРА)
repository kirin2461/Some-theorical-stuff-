openapi: 3.0.0
info:
  title: Coverage API
  version: 1.0.0

paths:
  /api/v1/coverage/point:
    get:
      summary: Получить покрытие в точке
      parameters:
        - name: lat
          in: query
          required: true
          schema:
            type: number
        - name: lon
          in: query
          required: true
          schema:
            type: number
        - name: radius
          in: query
          schema:
            type: number
            default: 100
      responses:
        200:
          description: Успешный ответ
          content:
            application/json:
              schema:
                type: object
                properties:
                  location:
                    type: object
                    properties:
                      lat: { type: number }
                      lon: { type: number }
                  operators:
                    type: array
                    items:
                      type: object
                      properties:
                        operator_id: { type: string }
                        operator_name: { type: string }
                        technologies:
                          type: array
                          items:
                            type: object
                            properties:
                              tech: { type: string, enum: [2G, 3G, 4G, 5G] }
                              signal_level: { type: string, enum: [excellent, good, fair, poor, none] }
                              signal_dbm: { type: number }
                              quality_score: { type: number, minimum: 0, maximum: 1 }
                              expected_speed:
                                type: object
                                properties:
                                  download_mbps: { type: number }
                                  upload_mbps: { type: number }
                                  latency_ms: { type: number }

  /api/v1/coverage/building/{building_id}:
    get:
      summary: Покрытие для здания
      parameters:
        - name: building_id
          in: path
          required: true
          schema:
            type: string
      responses:
        200:
          description: Успешный ответ
          content:
            application/json:
              schema:
                type: object
                properties:
                  building:
                    type: object
                    properties:
                      id: { type: string }
                      address: { type: string }
                      geometry: { type: object }
                  coverage:
                    type: array
                    items:
                      type: object
                      properties:
                        operator_id: { type: string }
                        operator_name: { type: string }
                        technologies: { type: array, items: { type: string } }
                        average_signal: { type: string }

  /api/v1/coverage/tiles:
    get:
      summary: Получить тайлы покрытия
      parameters:
        - name: bbox
          in: query
          required: true
          schema:
            type: string
            example: "37.6173,55.7558,37.6273,55.7658"
        - name: layer
          in: query
          schema:
            type: string
            enum: [mobile, fixed, quality, operators]
            default: mobile
        - name: zoom
          in: query
          schema:
            type: integer
            minimum: 1
            maximum: 18
      responses:
        200:
          description: GeoJSON FeatureCollection
          content:
            application/json:
              schema:
                type: object
                properties:
                  type: { type: string, enum: [FeatureCollection] }
                  features:
                    type: array
                    items:
                      type: object
                      properties:
                        type: { type: string, enum: [Feature] }
                        geometry: { type: object }
                        properties:
                          type: object
                          properties:
                            operator_id: { type: string }
                            tech: { type: string }
                            quality_score: { type: number }
