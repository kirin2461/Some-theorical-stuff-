- `GET /api/v1/fiber/nodes` - узлы в районе
- `GET /api/v1/fiber/buildings/:id/status` - статус здания

**Link Budget Calculation:**
```go
type LinkBudget struct {
    FiberLengthKm        float64
    AttenuationDbPerKm   float64
    SpliceCount          int
    SpliceLossDb         float64
    ConnectorCount       int
    ConnectorLossDb      float64
    SafetyMarginDb       float64
}

func (lb *LinkBudget) Calculate() float64 {
    fiberLoss := lb.FiberLengthKm * lb.AttenuationDbPerKm
    spliceLoss := float64(lb.SpliceCount) * lb.SpliceLossDb
    connectorLoss := float64(lb.ConnectorCount) * lb.ConnectorLossDb
    
    return fiberLoss + spliceLoss + connectorLoss + lb.SafetyMarginDb
}

func IsLinkViable(budget LinkBudget, txPowerDbm, rxSensitivityDbm float64) bool {
    totalLoss := budget.Calculate()
    availablePower := txPowerDbm - rxSensitivityDbm
    return totalLoss <= availablePower
}
```

